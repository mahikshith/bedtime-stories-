{
  "name": "lumi-sleepy-worlds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lumi & the Sleepy Worlds - offline-first personalized bedtime stories for children",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-privacy.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mascot": "node scripts/mascot-shot.cjs",
    "smoke": "node scripts/walkthrough.cjs && node scripts/pillars-shot.cjs && node scripts/games-shot.cjs && node scripts/motion-shot.cjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "cap:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/ios": "^6.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
