{
  "appId": "com.lumisleepyworlds.app",
  "appName": "Lumi",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": true
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#070a16",
      "showSpinner": false
    }
  }
}
